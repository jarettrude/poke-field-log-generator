# Pokemon Field Log Generator - Environment Variables

# Gemini API Key (server-side only)
GEMINI_API_KEY=


# Database type: 'sqlite' or 'mysql' (for future use)
DB_TYPE=sqlite

# Shared password that unlocks editing/generation. Anonymous visitors get a
# read-only /pokedex. Empty = auth disabled, everything open (dev mode).
POKEDEX_PASSWORD=
